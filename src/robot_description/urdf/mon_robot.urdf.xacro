<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mon_robot">

  <!-- Dimensions en mètres, masses en kg -->
  <xacro:property name="chassis_l" value="0.30"/>
  <xacro:property name="chassis_w" value="0.20"/>
  <xacro:property name="chassis_h" value="0.08"/>
  <xacro:property name="chassis_m" value="2.0"/>
  <xacro:property name="wheel_r" value="0.05"/>
  <xacro:property name="wheel_w" value="0.03"/>
  <xacro:property name="wheel_m" value="0.2"/>
  <xacro:property name="caster_r" value="0.025"/>
  <xacro:property name="caster_m" value="0.1"/>

  <material name="bleu"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="noir"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="gris"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- Macro : une roue motrice -->
  <xacro:macro name="wheel" params="side y_pos">
    <link name="${side}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="noir"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_m}"/>
        <inertia ixx="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" ixy="0" ixz="0"
                 iyy="${wheel_m*(3*wheel_r*wheel_r+wheel_w*wheel_w)/12}" iyz="0"
                 izz="${wheel_m*wheel_r*wheel_r/2}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y_pos} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <!-- Macro : une roue folle -->
  <xacro:macro name="caster" params="pos x_pos">
    <link name="${pos}_caster">
      <visual>
        <geometry><sphere radius="${caster_r}"/></geometry>
        <material name="gris"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_r}"/></geometry>
      </collision>
      <inertial>
        <mass value="${caster_m}"/>
        <inertia ixx="${2*caster_m*caster_r*caster_r/5}" ixy="0" ixz="0"
                 iyy="${2*caster_m*caster_r*caster_r/5}" iyz="0"
                 izz="${2*caster_m*caster_r*caster_r/5}"/>
      </inertial>
    </link>
    <joint name="${pos}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${pos}_caster"/>
      <origin xyz="${x_pos} 0 ${caster_r - wheel_r}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Repère au sol puis châssis -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_r}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="bleu"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_m}"/>
      <inertia ixx="${chassis_m*(chassis_w*chassis_w+chassis_h*chassis_h)/12}" ixy="0" ixz="0"
               iyy="${chassis_m*(chassis_l*chassis_l+chassis_h*chassis_h)/12}" iyz="0"
               izz="${chassis_m*(chassis_l*chassis_l+chassis_w*chassis_w)/12}"/>
    </inertial>
  </link>

  <!-- Assemblage -->
  <xacro:wheel side="left" y_pos="${chassis_w/2 + wheel_w/2}"/>
  <xacro:wheel side="right" y_pos="${-(chassis_w/2 + wheel_w/2)}"/>
  <xacro:caster pos="front" x_pos="${chassis_l/2 - 0.03}"/>
  <xacro:caster pos="back" x_pos="${-(chassis_l/2 - 0.03)}"/>
  <!-- Gazebo : roues folles sans frottement -->
  <gazebo reference="front_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="back_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Gazebo : moteurs et odométrie -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>
