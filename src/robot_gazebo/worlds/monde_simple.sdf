<?xml version="1.0"?>
<sdf version="1.9">
  <world name="monde_simple">

    <physics name="pas_4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="soleil">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="sol">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="arene">
      <static>true</static>

      <link name="mur_nord">
        <pose>0 4 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.2 0.2 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>

      <link name="mur_sud">
        <pose>0 -4 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>8.2 0.2 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>8.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>

      <link name="mur_est">
        <pose>4 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 8.2 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 8.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>

      <link name="mur_ouest">
        <pose>-4 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.2 8.2 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 8.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>

      <link name="obstacle_1">
        <pose>1.5 1.0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient><diffuse>0.8 0.3 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="obstacle_2">
        <pose>-1.0 -1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.8 0.4 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.4 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material>
        </visual>
      </link>

      <link name="obstacle_3">
        <pose>-2.0 2.0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.9 0.7 0.1 1</ambient><diffuse>0.9 0.7 0.1 1</diffuse></material>
        </visual>
      </link>

    </model>
  </world>
</sdf>
